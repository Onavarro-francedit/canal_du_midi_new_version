<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Establecer la base si estás en una subcarpeta
    RewriteBase /canal_du_midi/

    # Si entras a la raíz de la carpeta, ve a public/
    RewriteRule ^$ public/index.php [L]

    # Si pides algo que NO está en la carpeta public, búscalo dentro de public
    RewriteCond %{REQUEST_URI} !^/canal_du_midi/public/
    RewriteRule ^(.*)$ public/$1 [L]

    # Si el archivo no existe físicamente, mándalo al index.php de public
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>